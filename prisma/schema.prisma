// Web chat ↔ LINE OA
// ยังไม่ได้รัน migrate — ดู README.md หัวข้อ "Migrate"

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── enums ─────────────────────────

enum AdminRole {
  owner
  agent
}

enum ConversationStatus {
  open
  pending
  closed
}

enum MessageDirection {
  in // ลูกค้าส่งเข้ามา
  out // เราส่งออก
}

enum MessageType {
  text
  image
  video
  audio
  file
  sticker
  location
}

enum MediaStatus {
  pending
  ready
  failed
}

enum SendStatus {
  queued
  sent
  failed
}

enum ReceiptStatus {
  processing // กำลังให้ AI อ่าน
  done // อ่านเป็นใบเสร็จสำเร็จ
  not_receipt // AI อ่านแล้ว แต่รูปไม่ใช่ใบเสร็จ
  failed // ดึงรูป/เรียก AI ไม่สำเร็จ — ดู error
}

enum BillDirection {
  purchase // บิลซื้อ (ของเข้า / เราต้องจ่าย)
  sale // บิลขาย (ของออก / เราได้รับเงิน)
}

enum BillDocType {
  delivery_note // ใบส่งของ
  receipt // ใบเสร็จรับเงิน
  tax_invoice // ใบกำกับภาษี
  invoice // ใบแจ้งหนี้ / ใบวางบิล
  other
}

enum BillStatus {
  draft // AI อ่านแล้ว รอผู้ใช้ตรวจ/เลือกคู่ค้า
  confirmed // ผู้ใช้ยืนยันแล้ว → นับในยอดสรุป
  void // ยกเลิก (ไม่นับ)
}

// ───────────────────────── tables ─────────────────────────

/// แอดมินที่ใช้ web chat
model Admin {
  id        String    @id @default(uuid()) @db.Uuid
  email     String    @unique @db.VarChar(255)
  name      String    @db.VarChar(100)
  password  String    @db.VarChar(255)
  role      AdminRole @default(agent)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  assignedConversations Conversation[]
  sentMessages          Message[]

  @@map("admins")
}

// เก็บลูกค้าจากไลน์
model Contact {
  id           String    @id @default(uuid()) @db.Uuid
  lineUserId   String    @unique @map("line_user_id") @db.VarChar(64) // source.userId จาก webhook
  displayName  String?   @map("display_name") @db.VarChar(255)
  pictureUrl   String?   @map("picture_url")
  isFollowing  Boolean   @default(true) @map("is_following") // false = บล็อก OA → push ไม่ได้
  followedAt   DateTime? @map("followed_at") @db.Timestamptz
  unfollowedAt DateTime? @map("unfollowed_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  conversation   Conversation?
  bills          Bill[]
  partners       Partner[]
  partnerAliases PartnerAlias[]

  @@map("contacts")
}

// เก็บห้องแชท/ลูกค้า
model Conversation {
  id                 String             @id @default(uuid()) @db.Uuid
  contactId          String             @unique @map("contact_id") @db.Uuid
  status             ConversationStatus @default(open)
  assignedAdminId    String?            @map("assigned_admin_id") @db.Uuid
  lastMessageAt      DateTime?          @map("last_message_at") @db.Timestamptz
  lastMessagePreview String?            @map("last_message_preview") @db.VarChar(255)
  unreadCount        Int                @default(0) @map("unread_count")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz

  contact       Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignedAdmin Admin?    @relation(fields: [assignedAdminId], references: [id], onDelete: SetNull)
  messages      Message[]

  @@index([status, lastMessageAt(sort: Desc)])
  @@map("conversations")
}

// ข้อความทั้งเข้าและออก
model Message {
  id             String           @id @default(uuid()) @db.Uuid
  conversationId String           @map("conversation_id") @db.Uuid
  direction      MessageDirection
  senderAdminId  String?          @map("sender_admin_id") @db.Uuid // ใครตอบ (เฉพาะ out)
  type           MessageType
  text           String?
  payload        Json? // sticker id, location, ข้อมูลดิบอื่นๆ

  // ไฟล์แนบ (เก็บใน storage ของเราเอง)
  mediaPath   String?      @map("media_path")
  mediaMime   String?      @map("media_mime") @db.VarChar(100)
  mediaStatus MediaStatus? @map("media_status")

  // อ้างอิงฝั่ง LINE
  lineMessageId  String? @map("line_message_id") @db.VarChar(64)
  webhookEventId String? @unique @map("webhook_event_id") @db.VarChar(64) // กันบันทึกซ้ำ (in)
  retryKey       String? @unique @map("retry_key") @db.Uuid // X-Line-Retry-Key (out)

  // สถานะการส่ง (เฉพาะ out)
  sendStatus SendStatus? @map("send_status")
  sendError  String?     @map("send_error")

  isUnsent  Boolean  @default(false) @map("is_unsent") // ลูกค้ากดยกเลิกข้อความ
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  conversation      Conversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderAdmin       Admin?             @relation(fields: [senderAdminId], references: [id], onDelete: SetNull)
  receiptExtraction ReceiptExtraction?

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([lineMessageId])
  @@map("messages")
}

/// ผลที่ AI อ่านใบเสร็จจากรูปที่ลูกค้าส่งมาทาง LINE — ไม่เก็บตัวรูป (ดึงจาก LINE มาอ่านในหน่วยความจำแล้วทิ้ง)
model ReceiptExtraction {
  id        String        @id @default(uuid()) @db.Uuid
  messageId String        @unique @map("message_id") @db.Uuid // 1 รูป = 1 ผลอ่าน
  status    ReceiptStatus @default(processing)
  model     String?       @db.VarChar(100) // โมเดล AI ที่ใช้อ่าน
  data      Json? // JSON เต็มที่ AI ถอดได้ (รายการสินค้า, VAT ฯลฯ)

  // ช่องหลักแยกออกมา — ใช้ค้นหา/ส่งเข้า Google Sheet
  merchantName String?   @map("merchant_name") @db.VarChar(255)
  receiptNo    String?   @map("receipt_no") @db.VarChar(100)
  receiptDate  DateTime? @map("receipt_date") @db.Date // ปี ค.ศ. (แปลงจาก พ.ศ. แล้ว)
  totalAmount  Decimal?  @map("total_amount") @db.Decimal(12, 2)
  currency     String?   @db.VarChar(3)

  error         String?
  attempts      Int       @default(0)
  imageKey      String?   @map("image_key") @db.VarChar(255) // รูปบิลที่ย่อแล้วใน Cloudflare R2 (key ใน bucket)
  sheetSyncedAt DateTime? @map("sheet_synced_at") @db.Timestamptz // ส่งเข้า Google Sheet แล้วเมื่อไร (ขั้นถัดไป)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  message   Message    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  billImage BillImage?

  @@index([status])
  @@map("receipt_extractions")
}

/// บิลที่ผู้ใช้ตรวจ/แก้ได้ (ผลดิบจาก AI อยู่ใน receipt_extractions — แก้ที่นี่ไม่ทับผล AI)
/// 1 บิลมีได้หลายรูป (สูงสุด 3) และหลายรายการสินค้า
model Bill {
  id        String        @id @default(uuid()) @db.Uuid
  contactId String?       @map("contact_id") @db.Uuid // ผู้ใช้ LINE ที่ส่งบิล (ว่าง = เพิ่มจากหน้าเว็บ)
  direction BillDirection // ซื้อ / ขาย — ใช้แยกยอดซื้อ-ขาย-ค้างจ่าย
  docType   BillDocType   @default(other) @map("doc_type") // ใบส่งของ / ใบเสร็จ / ...
  status    BillStatus    @default(draft)

  billNo   String?   @map("bill_no") @db.VarChar(100) // เลขที่บิล
  billDate DateTime? @map("bill_date") @db.Date // วันที่ในบิล (ค.ศ.) — draft อาจยังไม่มี

  // คู่ค้า: ชื่อตามที่ AI อ่าน (ไม่แก้) + คู่ค้าที่ผู้ใช้เลือก (AI ไม่สร้าง/ไม่เลือกให้)
  partnerNameRaw  String? @map("partner_name_raw") @db.VarChar(255)
  partnerTaxIdRaw String? @map("partner_tax_id_raw") @db.VarChar(13)
  partnerId       String? @map("partner_id") @db.Uuid

  // เงิน
  subtotal      Decimal? @db.Decimal(12, 2) // ยอดก่อน VAT
  discount      Decimal? @db.Decimal(12, 2)
  vat           Decimal? @db.Decimal(12, 2)
  total         Decimal? @db.Decimal(12, 2) // ยอดสุทธิ
  paidAmount    Decimal  @default(0) @map("paid_amount") @db.Decimal(12, 2) // จ่าย/รับแล้ว → ค้าง = total - paid
  currency      String   @default("THB") @db.VarChar(3)
  paymentMethod String?  @map("payment_method") @db.VarChar(30)

  note          String?
  aiData        Json?     @map("ai_data") // ผลที่ AI อ่านจากรูปบิลล่าสุด (ดิบ)
  aiReadAt      DateTime? @map("ai_read_at") @db.Timestamptz
  confirmedAt   DateTime? @map("confirmed_at") @db.Timestamptz
  sheetSyncedAt DateTime? @map("sheet_synced_at") @db.Timestamptz // updatedAt > sheetSyncedAt = ต้องอัปเดตชีต
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  contact Contact?    @relation(fields: [contactId], references: [id], onDelete: Cascade)
  partner Partner?    @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  items   BillItem[]
  images  BillImage[]

  @@index([contactId, billDate]) // สรุปรายเดือน
  @@index([contactId, partnerId, billDate]) // สรุปตามคู่ค้า
  @@index([contactId, billNo]) // เช็คบิลซ้ำ
  @@index([contactId, status])
  @@index([partnerId, billDate])
  @@map("bills")
}

/// รายการสินค้าในบิล — 1 รายการ = 1 แถว (แก้ได้ / ใช้นับคงเหลือ)
model BillItem {
  id        String   @id @default(uuid()) @db.Uuid
  billId    String   @map("bill_id") @db.Uuid
  lineNo    Int      @map("line_no") // ลำดับในบิล เริ่ม 1
  name      String?  @db.VarChar(255) // AI อาจอ่านชื่อไม่ออก
  quantity  Decimal? @db.Decimal(12, 3)
  unit      String?  @db.VarChar(30) // หน่วยนับ: ชิ้น, กล่อง, กก.
  unitPrice Decimal? @map("unit_price") @db.Decimal(12, 2)
  amount    Decimal? @db.Decimal(12, 2)

  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@unique([billId, lineNo])
  @@map("bill_items")
}

/// รูปของบิล (สูงสุด 3 รูป) — รูปจริงอยู่ใน Cloudflare R2
model BillImage {
  id           String   @id @default(uuid()) @db.Uuid
  billId       String   @map("bill_id") @db.Uuid
  position     Int // รูปที่ 1–3
  imageKey     String?  @map("image_key") @db.VarChar(255) // key ใน R2 (img_ref) — ว่างได้ถ้าอัปโหลดไม่สำเร็จ
  extractionId String?  @unique @map("extraction_id") @db.Uuid // ผล AI ของรูปนี้ (ถ้ามาจาก LINE)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  bill       Bill               @relation(fields: [billId], references: [id], onDelete: Cascade)
  extraction ReceiptExtraction? @relation(fields: [extractionId], references: [id], onDelete: SetNull)

  @@unique([billId, position])
  @@map("bill_images")
}

/// คู่ค้า (ร้าน/ผู้ขาย/ลูกค้า) ของผู้ใช้แต่ละคน — ใช้ร่วมกันทั้งบิลซื้อและบิลขาย
/// สร้างเมื่อผู้ใช้กด "สร้างใหม่" เท่านั้น (AI ไม่สร้างเอง)
model Partner {
  id          String   @id @default(uuid()) @db.Uuid
  contactId   String?  @map("contact_id") @db.Uuid // ว่าง = คู่ค้ากลาง (ใช้ได้ทุกบิล)
  displayName String   @map("display_name") @db.VarChar(255)
  taxId       String?  @map("tax_id") @db.VarChar(13)
  phone       String?  @db.VarChar(20)
  note        String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  contact Contact?       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  bills   Bill[]
  aliases PartnerAlias[]

  @@unique([contactId, taxId]) // คู่ค้ากลาง (contactId ว่าง) เช็คเลขภาษีซ้ำในโค้ด
  @@index([contactId, displayName])
  @@index([taxId])
  @@map("partners")
}

/// ชื่ออื่นของคู่ค้าที่ผู้ใช้เคยยืนยัน เช่น "นายเอ", "เอ" → คู่ค้าเดียวกัน
model PartnerAlias {
  id        String   @id @default(uuid()) @db.Uuid
  contactId String?  @map("contact_id") @db.Uuid // ตามคู่ค้า (ว่าง = คู่ค้ากลาง)
  partnerId String   @map("partner_id") @db.Uuid
  alias     String   @db.VarChar(255) // ชื่อที่ normalize แล้ว (ตัดนาย/ร้าน/บริษัท...จำกัด/ช่องว่าง)
  rawName   String   @map("raw_name") @db.VarChar(255) // ตัวอย่างชื่อตามบิล
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  contact Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  partner Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([contactId, alias]) // คู่ค้ากลาง (contactId ว่าง) เช็คชื่อซ้ำในโค้ด
  @@index([alias]) // ชื่อหนึ่งชี้ไปได้คู่ค้าเดียว (ต่อผู้ใช้)
  @@index([partnerId])
  @@map("partner_aliases")
}

// log webhook ไว้ debug
model WebhookEvent {
  webhookEventId String    @id @map("webhook_event_id") @db.VarChar(64)
  eventType      String    @map("event_type") @db.VarChar(50)
  payload        Json
  isRedelivery   Boolean   @default(false) @map("is_redelivery")
  processedAt    DateTime? @map("processed_at") @db.Timestamptz
  error          String?
  receivedAt     DateTime  @default(now()) @map("received_at") @db.Timestamptz

  @@map("webhook_events")
}
